{
  "content": [
    { "id": "fssec1", "name": "section", "parent": 0, "children": ["fscon1"], "label": "Course Catalog (filters)",
      "settings": { "tag": "section", "_padding": { "top": "clamp(3rem, 6vw, 5rem)", "bottom": "clamp(3rem, 6vw, 5rem)" } } },
    { "id": "fscon1", "name": "container", "parent": "fssec1", "children": ["fslay1"],
      "settings": {} },
    { "id": "fslay1", "name": "div", "parent": "fscon1", "children": ["fsasd1", "fsmain"], "label": "Sidebar + Results",
      "settings": { "_display": "grid", "_gridTemplateColumns": "280px minmax(0, 1fr)", "_gridGap": "48px", "_alignItems": "start",
        "_gridTemplateColumns:tablet_portrait": "1fr" } },

    { "id": "fsasd1", "name": "block", "parent": "fslay1", "children": ["fsh001", "fsg001", "fsg002", "fsg003", "fsg004", "fsbtn1"], "label": "Filter Sidebar",
      "settings": { "tag": "aside", "_rowGap": "28px", "_position": "sticky", "_top": "24px", "_position:tablet_portrait": "static" } },
    { "id": "fsh001", "name": "heading", "parent": "fsasd1", "children": [],
      "settings": { "text": "Filter courses", "tag": "h2", "_typography": { "font-size": "1.25rem", "font-weight": "700" } } },

    { "id": "fsg001", "name": "block", "parent": "fsasd1", "children": ["fsl001", "fschk1"], "label": "Group: Category",
      "settings": { "_rowGap": "10px", "_cssGlobalClasses": ["fsgrp1"] } },
    { "id": "fsl001", "name": "text-basic", "parent": "fsg001", "children": [],
      "settings": { "text": "Category", "tag": "p", "_cssGlobalClasses": ["fslbl1"] } },
    { "id": "fschk1", "name": "filter-checkbox", "parent": "fsg001", "children": [],
      "settings": { "filterQueryId": "fsloop", "filterApplyOn": "click", "filterSource": "taxonomy", "filterTaxonomy": "course_category",
        "filterHierarchical": true, "filterMultiLogic": "OR", "filterHideEmpty": true, "filterNiceName": "category" } },

    { "id": "fsg002", "name": "block", "parent": "fsasd1", "children": ["fsl002", "fsrad1"], "label": "Group: Level",
      "settings": { "_rowGap": "10px", "_cssGlobalClasses": ["fsgrp1"] } },
    { "id": "fsl002", "name": "text-basic", "parent": "fsg002", "children": [],
      "settings": { "text": "Level", "tag": "p", "_cssGlobalClasses": ["fslbl1"] } },
    { "id": "fsrad1", "name": "filter-radio", "parent": "fsg002", "children": [],
      "settings": { "filterQueryId": "fsloop", "filterApplyOn": "click", "filterSource": "customField", "sourceFieldType": "post",
        "customFieldKey": "difficulty", "displayMode": "button", "filterLabelAll": "Any level", "filterNiceName": "level",
        "labelMapping": "custom",
        "customLabelMapping": [
          { "id": "fsmp01", "optionMetaValue": "beginner", "optionLabel": "Beginner" },
          { "id": "fsmp02", "optionMetaValue": "intermediate", "optionLabel": "Intermediate" },
          { "id": "fsmp03", "optionMetaValue": "advanced", "optionLabel": "Advanced" }
        ] } },

    { "id": "fsg003", "name": "block", "parent": "fsasd1", "children": ["fsl003", "fsrng1"], "label": "Group: Price",
      "settings": { "_rowGap": "10px", "_cssGlobalClasses": ["fsgrp1"] } },
    { "id": "fsl003", "name": "text-basic", "parent": "fsg003", "children": [],
      "settings": { "text": "Price (USD)", "tag": "p", "_cssGlobalClasses": ["fslbl1"] } },
    { "id": "fsrng1", "name": "filter-range", "parent": "fsg003", "children": [],
      "settings": { "filterQueryId": "fsloop", "filterApplyOn": "click", "filterSource": "customField", "sourceFieldType": "post",
        "customFieldKey": "price", "displayMode": "range", "step": 10, "labelMin": "From", "labelMax": "To",
        "labelThousandSeparator": true, "filterNiceName": "price",
        "sliderBarColorActive": { "hex": "#2563eb" }, "sliderThumbBackgroundColor": { "hex": "#2563eb" } } },

    { "id": "fsg004", "name": "block", "parent": "fsasd1", "children": ["fsl004", "fsdat1"], "label": "Group: Start date",
      "settings": { "_rowGap": "10px", "_cssGlobalClasses": ["fsgrp1"] } },
    { "id": "fsl004", "name": "text-basic", "parent": "fsg004", "children": [],
      "settings": { "text": "Starts between", "tag": "p", "_cssGlobalClasses": ["fslbl1"] } },
    { "id": "fsdat1", "name": "filter-datepicker", "parent": "fsg004", "children": [],
      "settings": { "filterQueryId": "fsloop", "filterApplyOn": "click", "filterSource": "customField", "sourceFieldType": "post",
        "customFieldKey": "start_date", "isDateRange": true, "enableTime": false, "dateFormat": "d/m/Y",
        "placeholder": "Pick a date range", "filterNiceName": "start" } },

    { "id": "fsbtn1", "name": "block", "parent": "fsasd1", "children": ["fssub1", "fsrst1"], "label": "Actions",
      "settings": { "_direction": "row", "_columnGap": "12px" } },
    { "id": "fssub1", "name": "filter-submit", "parent": "fsbtn1", "children": [],
      "settings": { "filterQueryId": "fsloop", "filterButtonType": "apply", "text": "Apply filters", "style": "primary", "size": "md" } },
    { "id": "fsrst1", "name": "filter-submit", "parent": "fsbtn1", "children": [],
      "settings": { "filterQueryId": "fsloop", "filterButtonType": "reset", "text": "Reset", "style": "dark", "outline": true, "size": "md", "hideOnNoFilter": true } },

    { "id": "fsmain", "name": "block", "parent": "fslay1", "children": ["fsact1", "fsgrd1", "fspag1"], "label": "Results",
      "settings": { "_rowGap": "24px" } },
    { "id": "fsact1", "name": "filter-active-filters", "parent": "fsmain", "children": [], "label": "Active Filter Chips",
      "settings": { "filterQueryId": "fsloop", "buttonSize": "sm", "buttonStyle": "light", "buttonCircle": true, "buttonGap": "8px",
        "icon": { "library": "ionicons", "icon": "ion-md-close" }, "iconPosition": "right", "iconGap": "6px" } },
    { "id": "fsgrd1", "name": "div", "parent": "fsmain", "children": ["fsloop"], "label": "Results Grid",
      "settings": { "_display": "grid", "_gridTemplateColumns": "repeat(2, minmax(0, 1fr))", "_gridGap": "24px",
        "_gridTemplateColumns:mobile_landscape": "1fr" } },
    { "id": "fsloop", "name": "block", "parent": "fsgrd1", "children": ["fsimg1", "fsttl1", "fsmet1"], "label": "Course Card (loop)",
      "settings": {
        "tag": "article",
        "hasLoop": true,
        "query": { "objectType": "post", "post_type": ["course"], "posts_per_page": "8", "orderby": "date", "order": "DESC" },
        "_rowGap": "10px" } },
    { "id": "fsimg1", "name": "image", "parent": "fsloop", "children": [],
      "settings": { "image": { "useDynamicData": "{featured_image}", "size": "medium_large" }, "altText": "{post_title}",
        "_width": "100%", "_aspectRatio": "16/9", "_objectFit": "cover",
        "_border": { "radius": { "top": "12px", "right": "12px", "bottom": "12px", "left": "12px" } } } },
    { "id": "fsttl1", "name": "heading", "parent": "fsloop", "children": [],
      "settings": { "text": "{post_title}", "tag": "h3", "link": { "type": "meta", "useDynamicData": "{post_url}" },
        "_typography": { "font-size": "1.125rem", "font-weight": "600" } } },
    { "id": "fsmet1", "name": "text-basic", "parent": "fsloop", "children": [],
      "settings": { "text": "{cf_difficulty} · ${cf_price} · starts {cf_start_date}", "tag": "p",
        "_typography": { "color": { "hex": "#64748b" }, "font-size": "0.9375rem" } } },
    { "id": "fspag1", "name": "pagination", "parent": "fsmain", "children": [],
      "settings": { "queryId": "fsloop", "ajax": true, "_justifyContent": "center" } }
  ],
  "source": "bricksCopiedElements",
  "sourceUrl": "https://example.com",
  "version": "2.4.2",
  "globalClasses": [
    { "id": "fsgrp1", "name": "filter-group",
      "settings": { "_padding": { "bottom": "20px" }, "_border": { "width": { "bottom": "1px" }, "style": "solid", "color": { "hex": "#e2e8f0" } } } },
    { "id": "fslbl1", "name": "filter-group__label",
      "settings": { "_typography": { "font-size": "0.875rem", "font-weight": "600", "text-transform": "uppercase", "letter-spacing": "0.05em", "color": { "hex": "#0f172a" } } } }
  ],
  "globalElements": []
}
