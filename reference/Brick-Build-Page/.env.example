# WordPress (scripts/lib/wp_session.py)
WP_URL=http://localhost:8000
WP_USER=
WP_PASS=

# Bricks MCP bridge — IDE-agnostic (scripts/lib/bricks_mcp.py)
# Lấy token từ WP Admin → Bricks MCP Bridge settings
BRICKS_MCP_URL=http://localhost:8000/wp-json/bricks-mcp-bridge/v1/mcp
BRICKS_MCP_TOKEN=Bearer <your-token>

# Figma REST API — export section PNG cho G4 auto (scripts/export_figma_section_pngs.py)
FIGMA_ACCESS_TOKEN=

# Optional: đọc token từ file JSON thay vì BRICKS_MCP_TOKEN
# MCP_CONFIG=./config/bricks-mcp.json
