# Site WordPress đích — nguồn sự thật DUY NHẤT về site (không phân biệt local/remote):
# đổi site chỉ cần sửa file này (+ .mcp.json cho MCP client), mọi script tự theo.
# Dùng bởi: capture_screenshot_logged_in.py, screenshot_templates.py,
# validate_css_compiled.py, validate_mobile_overflow.py, validate_line_clamp.py,
# capture_zoom_evidence.py, validate_g4_preflight.py
WP_URL=http://localhost:8000
WP_USER=
WP_PASS=

# Bricks MCP bridge — IDE-agnostic (scripts/lib/bricks_mcp.py)
# Lấy token từ WP Admin → Bricks MCP Bridge settings (có nút regenerate để rotate).
# Plugin >= 1.3.0 để có tool upload_media (rehost_assets.py cần).
BRICKS_MCP_URL=http://localhost:8000/wp-json/bricks-mcp-bridge/v1/mcp
BRICKS_MCP_TOKEN=<your-token>

# Figma REST API — dùng bởi inspect_figma_nodes.py / inspect_figma_children.py /
# dump_figma_spacings.py (đọc số liệu node khi không tiện dùng Figma MCP)
FIGMA_ACCESS_TOKEN=
# File key mặc định cho các script trên (bỏ trống thì truyền --file-key mỗi lần chạy)
FIGMA_FILE_KEY=
